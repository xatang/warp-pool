# ---------- warp-pool: настройки ----------
# Имя хоста в status.json (по умолчанию — hostname)
#HOST_NAME=exit1

# Сколько туннелей держать (wpool1..N). Меняешь — добавь outbound'ы в 3x-ui.
WARP_TUNNELS=5

# Движок туннелей:
#   wg  — ядерный WireGuard хоста. Быстро, рестарт контейнера не рвёт туннели. Для зарубежных VPS.
#   awg — AmneziaWG (userspace, внутри контейнера). Мусорные пакеты перед handshake — ТСПУ не узнаёт.
#         Для РФ-хостов. Рестарт контейнера = короткий разрыв туннелей.
#   masque — MASQUE (usque, userspace). HTTP/2 по TCP/443 с подменённым SNI. Для хостов, где ТСПУ
#         режет любой UDP до Cloudflare (WG/AWG живут ~20 пакетов). Засев аккаунта — см. README.
ENGINE=wg
# Только для ENGINE=masque: 1 — HTTP/2 (TCP), 0 — HTTP/3 (QUIC); SNI (пусто — родной); сервер (пусто — по умолчанию)
MASQUE_HTTP2=1
MASQUE_SNI=www.cloudflare.com
#MASQUE_ENDPOINT=162.159.198.2
#MASQUE_PORT=443
# Мусор AmneziaWG (только для ENGINE=awg). S1-S4=0 и H1-H4=1..4 зашиты — иначе Cloudflare не примет.
AWG_JC=4
AWG_JMIN=40
AWG_JMAX=70

# ---------- регистрация аккаунтов ----------
# Пути к API WARP по очереди: напрямую -> REG_PROXY -> через уже живой туннель пула.
# На РФ-хосте, где api.cloudflareclient.com режется: REG_DIRECT=0 и засеять пул командой import (см. README).
REG_DIRECT=1
# HTTP-прокси для регистрации, напр. http://127.0.0.1:10809 (HTTP-инбаунд xray, уходящий в каскад). Пусто — не использовать.
REG_PROXY=
REG_VIA_TUNNEL=1

# Эндпоинты WARP.
# auto — демон сам берёт адреса из подсетей WARP (AUTO_SUBNETS × AUTO_PORTS),
#        запоминает рабочие и на BAD_ENDPOINT_TTL банит те, на которых туннель лёг.
# Или фиксированный список: ENDPOINTS=162.159.192.1:2408,188.114.96.1:1701,...
ENDPOINTS=auto
# (необязательно) откуда брать адреса в режиме auto
#AUTO_SUBNETS=162.159.192.0/24,162.159.193.0/24,162.159.195.0/24,188.114.96.0/24,188.114.97.0/24,188.114.98.0/24,188.114.99.0/24
#AUTO_PORTS=2408,1701,500,4500,854,878,894,908,928,987,1002,2371,7559,8854
# сек бана эндпоинта, на котором туннель лёг
BAD_ENDPOINT_TTL=21600
# столько разных IP легли на одном порту → порт в бан целиком (провайдер режет порт)
BAD_PORT_AFTER=3

# ---------- пробы ----------
# сек между проверками
PROBE_INTERVAL=30
# таймаут одной проверки, сек
PROBE_TIMEOUT=8
# неудач подряд, после которых туннель считается лежащим
FAIL_THRESHOLD=3

# ---------- починка ----------
# сколько раз сменить эндпоинт перед новой регистрацией
ENDPOINT_TRIES=2
# сек между действиями по одному туннелю
ACTION_COOLDOWN=120
# сек между регистрациями одного туннеля
REG_COOLDOWN=600
# лимит регистраций на весь хост
MAX_REG_PER_HOUR=6
# сек без единого handshake после поднятия, чтобы счесть аккаунт битым
DEAD_ACCOUNT_AFTER=300

# ---------- сеть ----------
MTU=1280
# сам выключится, если на хосте нет IPv6
ENABLE_IPV6=1
# таблицы маршрутизации 5101..510N
TABLE_BASE=5100
# приоритеты ip rule 5101..510N
RULE_PRIO_BASE=5100

# ---------- прочее ----------
# строка [status] в лог раз в N сек (и сразу при изменениях)
SUMMARY_INTERVAL=600
# DEBUG — видно причину каждой неудачной пробы
LOG_LEVEL=INFO
